# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local

# Base URL of the backend/API the frontend talks to (no trailing slash).
# Same-origin "/api" is proxied by app/api/[...path]/route.ts to backend services.
NEXT_PUBLIC_API_URL=/api

# Direct Java backend URL for feature APIs (bypasses Next.js proxy).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Server-only: backend service URLs (no trailing slash).
# Path-based routing: /api/identity/* → BACKEND_IDENTITY_URL, /api/company/* → BACKEND_COMPANY_URL, etc.
# Unmatched paths fall through to BACKEND_URL (default gateway).
BACKEND_URL=http://localhost:8080
BACKEND_IDENTITY_URL=http://localhost:8081
BACKEND_COMPANY_URL=http://localhost:8082
BACKEND_DOCUMENT_URL=http://localhost:8083

# Secret used to sign auth session cookies / tokens.
# Generate one locally with: openssl rand -base64 32
AUTH_SECRET=

# Public URL of the deployed app (used for auth callbacks / redirects).
# https://<your-deployment>.vercel.app in production, http://localhost:3000 locally.
AUTH_URL=http://localhost:3000