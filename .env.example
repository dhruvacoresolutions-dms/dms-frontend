# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local

# Base URL of the backend/API the frontend talks to (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Secret used to sign auth session cookies / tokens.
# Generate one locally with: openssl rand -base64 32
AUTH_SECRET=

# Public URL of the deployed app (used for auth callbacks / redirects).
# https://<your-deployment>.vercel.app in production, http://localhost:3000 locally.
AUTH_URL=http://localhost:3000